{
  "name": "@basaltic-sh/sdk-js",
  "version": "0.3.0",
  "description": "Official TypeScript and JavaScript SDK for the Basaltic cloud platform",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://basaltic.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltic-sh/sdk-js.git"
  },
  "bugs": {
    "url": "https://docs.basaltic.sh"
  },
  "keywords": [
    "basaltic",
    "cloud",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "lint": "prettier --check src scripts tests package.json tsconfig*.json",
    "format": "prettier --write src scripts tests package.json tsconfig*.json",
    "check": "npm run build && npm run typecheck && npm test && npm run lint",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
